{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=khalilResumeDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Secret": "SuperSecretKeyWithAtLeast32BytesLengthHere!",
    "Issuer": "khalilResume",
    "Audience": "khalilResumeAudience"
  },
  "Serilog": {
    "Using": [ "Serilog.AspNetCore" ],
